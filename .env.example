# === LLM (Groq) ===
# Créez une clé gratuite sur https://console.groq.com/keys
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# === Base de données ===
DATABASE_URL=sqlite:///./data/app.db

# === Backend calendrier: "db" ou "caldav" ===
CALENDAR_BACKEND=db

# === CalDAV (utilisé uniquement si CALENDAR_BACKEND=caldav) ===
# URL racine du serveur CalDAV (ex: http://127.0.0.1:5232)
CALDAV_URL=
# Filtrage par nom de calendrier (optionnel, via découverte principal)
CALDAV_CALENDAR_NAME=
# URL directe d'une collection (court-circuite la découverte).
# Exemple Radicale: http://127.0.0.1:5232/<user>/<uuid>/
CALDAV_USERNAME=admin
CALDAV_PASSWORD=admin
CALDAV_CALENDAR_URL=http://127.0.0.1:5232/admin/ed06ced5-0851-39bc-fe2c-3ac4a61b08fe


# === API ===
API_KEY=
LOG_LEVEL=INFO
