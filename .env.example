# === LLM (Groq) ===
# Créez une clé gratuite sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === Base de données ===
DATABASE_URL=sqlite:///./data/app.db

# === Backend calendrier: "db" ou "caldav" ===
CALENDAR_BACKEND=db

# === CalDAV (utilisé uniquement si CALENDAR_BACKEND=caldav) ===
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR_NAME=

# === API ===
API_KEY=
LOG_LEVEL=INFO
